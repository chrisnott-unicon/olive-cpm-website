rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isEmailSuperAdmin() {
      return request.auth != null && request.auth.token.email in ['chris.nott@uniconsa.co.za', 'chris.nott@unicons.co.za'];
    }
    
    function canAccessProject(projectId) {
      // Avoid firestore.exists cross-service limits and errors for now
      return request.auth != null;
    }

    match /projects/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

