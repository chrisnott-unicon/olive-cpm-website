rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isEmailSuperAdmin() {
      return request.auth != null && request.auth.token.email in ['chris.nott@uniconsa.co.za', 'chris.nott@unicons.co.za'];
    }

    // Mirrors firestore.rules' canAccessProject/isOrgSubscribed — Storage
    // rules CAN cross-reference Firestore via firestore.get()/firestore.exists(),
    // the old comment claiming otherwise is what left this wide open to any
    // signed-in user regardless of tenant.
    function getUserOrgId() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('orgId', null)
        : null;
    }

    function canAccessProject(projectId) {
      return request.auth != null && (
        isEmailSuperAdmin() ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'Super_Admin') ||
        (firestore.exists(/databases/(default)/documents/projects/$(projectId))
          && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.get('orgId', '') == getUserOrgId()) ||
        firestore.exists(/databases/(default)/documents/projects/$(projectId)/stakeholders/$(request.auth.uid))
      );
    }

    match /projects/{projectId}/{allPaths=**} {
      allow read, write: if canAccessProject(projectId);
    }
  }
}

